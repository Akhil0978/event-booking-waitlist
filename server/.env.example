# Copy to .env for a fresh setup and fill in your own values.
# Never commit database credentials or a real session secret.
MONGODB_URI=
SESSION_SECRET=

# Optional local settings:
DNS_SERVERS=
APP_ORIGINS=

# The local frontend proxy expects the backend on port 3001.
# PORT=3001
# TRUST_PROXY_HOPS=0

# Production serves client/dist from Express and uses Secure cookies.
# Run the frontend build before starting in production.
# NODE_ENV=production
# APP_ORIGINS=https://your-app.example
# On Render, APP_ORIGINS defaults to the supplied RENDER_EXTERNAL_URL.
# render.yaml sets TRUST_PROXY_HOPS=1 for the Render reverse proxy.
# Other hosts must use their actual trusted proxy topology.

